{
  "FileStorage": {
    "RootPath": "wwwroot/uploads",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".pdf"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "HomeInventory.API",
    "ServiceVersion": "1.0.0",
    "EnableLogging": true,
    "EnableTracing": true,
    "EnableMetrics": true,
    "Exporters": {
      "Console": {
        "Enabled": true
      },
      "Otlp": {
        "Enabled": false,
        "Endpoint": "http://localhost:4317"
      }
    }
  },
  "AllowedHosts": "*"
}
