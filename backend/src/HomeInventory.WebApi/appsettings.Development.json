{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Postgres": {
    "ConnectionString": "Host=localhost;Port=15432;Database=homeinventory;Username=postgres;Password=postgres"
  },
  "Cors": [
    {
      "Name": "AllowFrontend",
      "AllowedOrigins": [
        "http://localhost:3000",
        "https://localhost:3000"
      ]
    }
  ],
  "OpenTelemetry": {
    "ServiceName": "HomeInventory.API",
    "ServiceVersion": "1.0.0",
    "EnableLogging": true,
    "EnableTracing": true,
    "EnableMetrics": false,
    "Exporters": {
      "Console": {
        "Enabled": true
      },
      "Otlp": {
        "Enabled": true,
        "Endpoint": "http://localhost:11001"
      }
    }
  }
}
